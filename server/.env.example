# ---------------------------------------------------------------------------
# TEMPLATE — copy to `server/.env` and fill in. NEVER COMMIT `.env`.
#
#   Copy-Item server/.env.example server/.env
#
# This file IS committed, so it must only ever contain placeholders or local
# dev defaults. NEVER paste a real connection string, password, API key or
# token here — this file ends up on GitHub.
#
# Gotcha: a blank value means "not set", so the default applies. It is NOT
# treated as an empty string.
# ---------------------------------------------------------------------------

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
# Set to "true" only on long-lived servers (Render / Docker / VPS) so the
# BullMQ worker + overdue sweep run inside the API process. Leave blank on
# Vercel serverless — run server/src/worker.ts as a separate background worker.
START_BACKGROUND_JOBS=
# Only set when running behind a proxy you control. Leave blank locally.
TRUST_PROXY=

# ---- Database (D3: MongoDB Atlas) -----------------------------------------
# REQUIRED. Paste the mongodb+srv:// string from MongoDB Atlas.
#
# Before it works you also need, in the Atlas UI:
#   1. A database named exactly what MONGODB_DB says below.
#   2. Network Access -> IP allowlist entry for THIS machine
#      (get it with:  curl.exe ifconfig.me ). Never use 0.0.0.0/0.
MONGODB_URI=
MONGODB_DB=skills_connect_admin
MONGODB_TIMEOUT_MS=10000

# ---- Queue (B5: BullMQ) ---------------------------------------------------
# Matches the `redis` service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# ---- HTTP -----------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=1mb

# ---- Auth (B2) ------------------------------------------------------------
# Consumed from Phase B2. You generate these yourself — they are NOT issued by
# any provider and there is nothing to "get" or sign up for.
#
#   Each one must be a long random string (32+ bytes). Generate in PowerShell:
#     $b = New-Object byte[] 48
#     [Security.Cryptography.RandomNumberGenerator]::Fill($b)
#     [Convert]::ToBase64String($b)
#
#   NEVER reuse these values in staging/production. Generate a fresh pair per
#   environment. Rotating them logs every user out.
#
# JWT_ACCESS_SECRET  signs the 15-minute access token.
# JWT_REFRESH_SECRET signs the rotating refresh token held in an httpOnly cookie.
# They MUST be different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Rate limiting ----
# Per-IP login attempts inside the window, plus a global backstop for every
# other route. Both are shared across API instances when Redis is up.
#
# The local dev values are deliberately loose: a developer or the smoke suite
# legitimately signs in many times per session, and the smoke suite makes ~14
# logins per run. In production keep LOGIN_RATE_LIMIT_MAX low (5 is the
# default) — the per-account lockout at 10 failures is the real brute-force
# control and is unaffected by this.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MIN=1

# ---- QuickBooks (B5) ----------------------------------------------------
# All of these are OPTIONAL. With them blank the API boots, every finance
# screen works, and QuickBooks syncs simply stay in `Failed` with a named
# reason — nothing else is blocked.
#
# Get them from the Intuit Developer portal (sandbox app):
#   1. Create an app, add the `com.intuit.quickbooks.accounting` scope.
#   2. Add a redirect URI: http://localhost:4000/integrations/quickbooks/callback
#   3. Copy the Client ID / Client Secret.
#   4. Authorise the company at /integrations/quickbooks/connect — the OAuth
#      token pair is then stored in the database, NOT here.
#
# QB_SANDBOX=true targets sandbox-quickbooks.api.intuit.com. Set it to false
# for production, and use production credentials there.
QB_REALM_ID=
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_SANDBOX=true

# The verifier token from the Intuit app's webhook endpoint. WITHOUT it the
# webhook route refuses every callback (401) — an unsigned "your sync failed"
# notification is worse than no webhook at all.
QB_WEBHOOK_SECRET=

# QuickBooks Account id that invoice revenue is posted to. Leave as 1 unless
# the chart of accounts differs.
QB_INCOME_ACCOUNT_ID=1