{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run server:build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/(auth|clients|communications|documents|finance|invoices|orders|payment-plans|payments|qualifications|reports|rtos|supplier-routes|integrations|roles|saved-views|users|workflow|audit|health)(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ]
}
