# Front-end environment (Vite). Safe to commit — contains NO secrets.
#
# ⚠️  NEVER put a database connection string, API key or token in this file.
#     This file IS tracked by git. Frontend code is public, so anything here
#     reaches the browser and is visible to anyone who opens the repo or the
#     dev-tools network tab.
#
# All backend secrets belong in `server/.env` (git-ignored), created from
# `server/.env.example`. See server/README.md.
#
# Copy this file to `.env.local` only if you need to override these values.

VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=Skills Connect Admin