# Skills Connect Admin — All-in-One Next.js Backend
# Copy to .env.local and fill in values. Never commit .env.

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/skills_connect_admin?retryWrites=true&w=majority
MONGODB_DB=skills_connect_admin

# ---- Auth (JWT access + rotating refresh) ----
# Generate two different 32+ char secrets:
#   [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
JWT_ACCESS_SECRET=<32+ random chars>
JWT_REFRESH_SECRET=<different 32+ random chars>

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Cookie ----
# false in dev (http on localhost); true in production (https)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---- Rate limiting ----
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15
ACCOUNT_LOCK_MAX_FAILURES=10
ACCOUNT_LOCK_MINUTES=15

# ---- Optional: external API base. Leave empty for single Next.js service
# (frontend calls /api/* Route Handlers on the same origin). Set only when
# calling a separate backend service.
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_APP_NAME=Skills Connect Admin

# ---- Seed admin (first-run) ----
SEED_ADMIN_EMAIL=admin@skillsconnect.example
SEED_ADMIN_PASSWORD=<12+ char password>
SEED_ADMIN_NAME=Super Admin
