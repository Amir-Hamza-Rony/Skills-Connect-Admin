# Front-end environment (Next.js). Safe to commit — contains NO secrets.
#
# ⚠️  NEVER put a database connection string, API key or token in this file.
#     This file IS tracked by git. Every `NEXT_PUBLIC_*` value is inlined into
#     the browser bundle at build time, so anything here is public.
#
# All backend secrets belong in `server/.env` (git-ignored), created from
# `server/.env.example`. See server/README.md.
#
# Next.js loads `.env` automatically. Copy this file to `.env.local` only if you
# need to override these values locally.

# Base URL of the API. `src/lib/api.ts` sends `credentials: "include"` on every
# call so the httpOnly refresh cookie travels with it, which means the API's
# `CORS_ORIGINS` must list this app's origin. `localhost:3000` and
# `localhost:4000` are the same *site* (ports don't affect it), so
# `SameSite=lax` still applies — but if you ever host the API on a different
# domain you must set `COOKIE_SAME_SITE=none` + `COOKIE_SECURE=true` on the
# server, or the browser will silently drop the session cookie.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

NEXT_PUBLIC_APP_NAME=Skills Connect Admin
