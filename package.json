{
  "name": "skills-connect-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit && npm run server:typecheck",
    "server:dev": "npm run dev --workspace=@sc/server",
    "server:build": "npm run build --workspace=@sc/server",
    "server:start": "npm run start --workspace=@sc/server",
    "server:seed": "npm run seed --workspace=@sc/server",
    "server:smoke": "npm run smoke --workspace=@sc/server",
    "server:verify:queue": "npm run verify:queue --workspace=@sc/server",
    "server:test": "npm run test --workspace=@sc/server",
    "server:typecheck": "npm run typecheck --workspace=@sc/server"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  }
}
