{
  "name": "skills-connect-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server:dev": "npm run dev --workspace=@sc/server",
    "server:build": "npm run build --workspace=@sc/server",
    "server:start": "npm run start --workspace=@sc/server",
    "server:seed": "npm run seed --workspace=@sc/server",
    "server:smoke": "npm run smoke --workspace=@sc/server",
    "server:test": "npm run test --workspace=@sc/server",
    "server:typecheck": "npm run typecheck --workspace=@sc/server",
    "typecheck": "tsc -b && npm run server:typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
